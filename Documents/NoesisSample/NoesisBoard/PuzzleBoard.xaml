<!--
  NoesisBoard - the puzzle board screen for all eight puzzles.  GENERATED: edit
  Documents/Tools/build_noesis_board_xaml.js and run it again, do not edit this file.

  Script: NoesisBoard_Panel.ts. Rows follow PuzzleBoardUI_Panel: top inset 6% /
  board 7 : aux 3 / bottom inset 8%. The board square is a Viewbox over a
  900 x 900 design; cells flow into a WrapPanel in cell-index order and wrap at GridWidth.
-->
<Grid
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
	x:Name="Root" Background="#FF14171F">

	<Grid.Resources>
		<Style x:Key="BarButton" TargetType="Button">
			<Setter Property="Foreground" Value="#FFFFFFFF"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- The cell's own box is the hit area (gap included, so neighbours touch); only the face inside scales. -->
		<DataTemplate x:Key="BoardCell">
			<Grid Width="{Binding Size}" Height="{Binding Size}" Background="Transparent">
				<b:Interaction.Triggers>
					<b:EventTrigger EventName="MouseLeftButtonDown">
						<b:InvokeCommandAction Command="{Binding OnDown}"/>
					</b:EventTrigger>
					<b:EventTrigger EventName="TouchDown">
						<b:InvokeCommandAction Command="{Binding OnDown}"/>
					</b:EventTrigger>
					<b:EventTrigger EventName="MouseEnter">
						<b:InvokeCommandAction Command="{Binding OnEnter}"/>
					</b:EventTrigger>
					<b:EventTrigger EventName="TouchEnter">
						<b:InvokeCommandAction Command="{Binding OnEnter}"/>
					</b:EventTrigger>
					<b:EventTrigger EventName="MouseLeave">
						<b:InvokeCommandAction Command="{Binding OnLeave}"/>
					</b:EventTrigger>
					<b:EventTrigger EventName="TouchLeave">
						<b:InvokeCommandAction Command="{Binding OnLeave}"/>
					</b:EventTrigger>
				</b:Interaction.Triggers>
				<Grid Margin="{Binding FaceMargin}" Opacity="{Binding Alpha}" IsHitTestVisible="False">
					<Border CornerRadius="8" Background="{Binding Fill}"/>
					<Image Source="{Binding Tex}" Stretch="UniformToFill"/>
					<TextBlock Text="{Binding Label}" Foreground="{Binding LabelColor}" FontSize="{Binding Font}" FontWeight="Bold"
							   HorizontalAlignment="Center" VerticalAlignment="Center"/>
					<Border CornerRadius="8" BorderBrush="#FFFAEB8C" BorderThickness="{Binding Glyph}"/>
					<Border CornerRadius="8" BorderBrush="{Binding Edge}" BorderThickness="{Binding EdgeWidth}"/>
				</Grid>
			</Grid>
		</DataTemplate>

		<DataTemplate x:Key="SideCell">
			<Grid Width="{Binding Size}" Height="{Binding Size}">
				<Grid Margin="{Binding FaceMargin}" Opacity="{Binding Alpha}" IsHitTestVisible="False">
					<Border CornerRadius="6" Background="{Binding Fill}"/>
					<Image Source="{Binding Tex}" Stretch="UniformToFill"/>
					<TextBlock Text="{Binding Label}" Foreground="{Binding LabelColor}" FontSize="{Binding Font}" FontWeight="Bold"
							   HorizontalAlignment="Center" VerticalAlignment="Center"/>
					<Border CornerRadius="6" BorderBrush="{Binding Edge}" BorderThickness="{Binding EdgeWidth}"/>
				</Grid>
			</Grid>
		</DataTemplate>

		<DataTemplate x:Key="TrayItem">
			<Grid Width="{Binding Size}" Height="{Binding Size}" Background="Transparent">
				<b:Interaction.Triggers>
					<b:EventTrigger EventName="MouseLeftButtonDown">
						<b:InvokeCommandAction Command="{Binding OnDown}"/>
					</b:EventTrigger>
					<b:EventTrigger EventName="TouchDown">
						<b:InvokeCommandAction Command="{Binding OnDown}"/>
					</b:EventTrigger>
				</b:Interaction.Triggers>
				<Grid Margin="{Binding FaceMargin}" Opacity="{Binding Alpha}" IsHitTestVisible="False">
					<Border CornerRadius="10" Background="{Binding Fill}"/>
					<Image Source="{Binding Tex}" Stretch="UniformToFill"/>
					<TextBlock Text="{Binding Label}" Foreground="{Binding LabelColor}" FontSize="40" FontWeight="Bold"
							   HorizontalAlignment="Center" VerticalAlignment="Center"/>
					<TextBlock Text="{Binding Caption}" Foreground="#FFFFFFFF" FontSize="18" FontWeight="Bold"
							   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,2"/>
					<Border CornerRadius="10" BorderBrush="#FFFAEB8C" BorderThickness="{Binding Glyph}"/>
					<Border CornerRadius="10" BorderBrush="{Binding Edge}" BorderThickness="{Binding EdgeWidth}"/>
				</Grid>
			</Grid>
		</DataTemplate>
	</Grid.Resources>

	<!--
	  Every release ends here, wherever the finger is - the script's pointerUp() works only once per press.
	  A touch release can be raised on the element the touch STARTED on rather than the one under the
	  finger, so where the finger is at that moment is never read from this event; the script tracks
	  it from Enter / Leave instead.
	  The root size goes to the script for the bar font and the tray arrangement (Loaded can come
	  before the dataContext, so the first press sends it again). The re-send MUST sit on the touch
	  press as well as the mouse press: on mobile the mouse press never fires, so a mouse-only
	  re-send leaves the script with no root size, no board rect, and no way to turn pointer pixels
	  into grid coordinates - the grab then misses every piece.
	-->
	<b:Interaction.Triggers>
		<!--
		  Root size FIRST, pointer handlers after. Both blocks answer PreviewMouseLeftButtonDown /
		  PreviewTouchDown, and triggers run in document order - so putting the size ahead means the
		  script already knows the board rect when the press handler runs and can tell which piece was
		  grabbed. The other way round, the very first press on a device whose Loaded fired before the
		  dataContext is resolved against a board rect of zero and grabs nothing.
		-->
		<b:EventTrigger EventName="Loaded">
			<b:InvokeCommandAction Command="{Binding OnRootWidth}" CommandParameter="{Binding ActualWidth, ElementName=Root}"/>
			<b:InvokeCommandAction Command="{Binding OnRootHeight}" CommandParameter="{Binding ActualHeight, ElementName=Root}"/>
		</b:EventTrigger>
		<b:EventTrigger EventName="SizeChanged">
			<b:InvokeCommandAction Command="{Binding OnRootWidth}" CommandParameter="{Binding ActualWidth, ElementName=Root}"/>
			<b:InvokeCommandAction Command="{Binding OnRootHeight}" CommandParameter="{Binding ActualHeight, ElementName=Root}"/>
		</b:EventTrigger>
		<b:EventTrigger EventName="PreviewMouseLeftButtonDown">
			<b:InvokeCommandAction Command="{Binding OnRootWidth}" CommandParameter="{Binding ActualWidth, ElementName=Root}"/>
			<b:InvokeCommandAction Command="{Binding OnRootHeight}" CommandParameter="{Binding ActualHeight, ElementName=Root}"/>
		</b:EventTrigger>
		<b:EventTrigger EventName="PreviewTouchDown">
			<b:InvokeCommandAction Command="{Binding OnRootWidth}" CommandParameter="{Binding ActualWidth, ElementName=Root}"/>
			<b:InvokeCommandAction Command="{Binding OnRootHeight}" CommandParameter="{Binding ActualHeight, ElementName=Root}"/>
		</b:EventTrigger>
		<b:EventTrigger EventName="PreviewMouseLeftButtonDown">
			<b:InvokeCommandAction Command="{Binding OnMouseDown}" PassEventArgsToCommand="True"/>
		</b:EventTrigger>
		<b:EventTrigger EventName="MouseMove">
			<b:InvokeCommandAction Command="{Binding OnMouseMove}" PassEventArgsToCommand="True"/>
		</b:EventTrigger>
		<b:EventTrigger EventName="MouseLeftButtonUp">
			<b:InvokeCommandAction Command="{Binding OnMouseUp}" PassEventArgsToCommand="True"/>
		</b:EventTrigger>
		<b:EventTrigger EventName="PreviewTouchDown">
			<b:InvokeCommandAction Command="{Binding OnTouchDown}" PassEventArgsToCommand="True"/>
		</b:EventTrigger>
		<b:EventTrigger EventName="TouchMove">
			<b:InvokeCommandAction Command="{Binding OnTouchMove}" PassEventArgsToCommand="True"/>
		</b:EventTrigger>
		<b:EventTrigger EventName="TouchUp">
			<b:InvokeCommandAction Command="{Binding OnTouchUp}" PassEventArgsToCommand="True"/>
		</b:EventTrigger>
	</b:Interaction.Triggers>

	<Grid.RowDefinitions>
		<RowDefinition Height="6*"/>
		<RowDefinition Height="60.2*"/>
		<RowDefinition Height="25.8*"/>
		<RowDefinition Height="8*"/>
	</Grid.RowDefinitions>

	<!-- Top inset: status bar / notch room, and the optional title. -->
	<TextBlock Grid.Row="0" Text="{Binding Title}" Visibility="{Binding TitleVis}" FontSize="{Binding BarFont}" FontWeight="Bold"
			   Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>

	<!-- Board area: a square, 96% of the width and 94% of this row at most. -->
	<Grid Grid.Row="1">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="2.0*"/>
			<ColumnDefinition Width="96*"/>
			<ColumnDefinition Width="2.0*"/>
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="3.0*"/>
			<RowDefinition Height="94*"/>
			<RowDefinition Height="3.0*"/>
		</Grid.RowDefinitions>
		<Viewbox Grid.Row="1" Grid.Column="1" Stretch="Uniform">
			<Grid Width="900" Height="900">
				<Image Source="{Binding BoardTex}" Stretch="UniformToFill" IsHitTestVisible="False"/>
				<ItemsControl Width="{Binding GridWidth}" HorizontalAlignment="Center" VerticalAlignment="Center" ItemsSource="{Binding Cells}" ItemTemplate="{StaticResource BoardCell}">
					<ItemsControl.Template>
						<ControlTemplate TargetType="ItemsControl">
							<ItemsPresenter/>
						</ControlTemplate>
					</ItemsControl.Template>
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
				</ItemsControl>
				<!-- Piece layer: 20 slots placed by the script in the same 900 design space as the cells. -->
				<Canvas IsHitTestVisible="False">
					<Grid Canvas.Left="{Binding P1X}" Canvas.Top="{Binding P1Y}" Width="{Binding P1W}" Height="{Binding P1H}"
						  Visibility="{Binding P1Vis}" Opacity="{Binding P1Alpha}">
						<Border CornerRadius="10" Background="{Binding P1Fill}"/>
						<Image Source="{Binding P1Tex}" Stretch="UniformToFill"/>
						<TextBlock Text="{Binding P1Label}" Foreground="{Binding P1LabelColor}" FontSize="{Binding P1Font}" FontWeight="Bold"
								   HorizontalAlignment="Center" VerticalAlignment="Center"/>
						<Border CornerRadius="10" BorderBrush="{Binding P1Edge}" BorderThickness="{Binding P1EdgeWidth}"/>
					</Grid>
					<Grid Canvas.Left="{Binding P2X}" Canvas.Top="{Binding P2Y}" Width="{Binding P2W}" Height="{Binding P2H}"
						  Visibility="{Binding P2Vis}" Opacity="{Binding P2Alpha}">
						<Border CornerRadius="10" Background="{Binding P2Fill}"/>
						<Image Source="{Binding P2Tex}" Stretch="UniformToFill"/>
						<TextBlock Text="{Binding P2Label}" Foreground="{Binding P2LabelColor}" FontSize="{Binding P2Font}" FontWeight="Bold"
								   HorizontalAlignment="Center" VerticalAlignment="Center"/>
						<Border CornerRadius="10" BorderBrush="{Binding P2Edge}" BorderThickness="{Binding P2EdgeWidth}"/>
					</Grid>
					<Grid Canvas.Left="{Binding P3X}" Canvas.Top="{Binding P3Y}" Width="{Binding P3W}" Height="{Binding P3H}"
						  Visibility="{Binding P3Vis}" Opacity="{Binding P3Alpha}">
						<Border CornerRadius="10" Background="{Binding P3Fill}"/>
						<Image Source="{Binding P3Tex}" Stretch="UniformToFill"/>
						<TextBlock Text="{Binding P3Label}" Foreground="{Binding P3LabelColor}" FontSize="{Binding P3Font}" FontWeight="Bold"
								   HorizontalAlignment="Center" VerticalAlignment="Center"/>
						<Border CornerRadius="10" BorderBrush="{Binding P3Edge}" BorderThickness="{Binding P3EdgeWidth}"/>
					</Grid>
					<Grid Canvas.Left="{Binding P4X}" Canvas.Top="{Binding P4Y}" Width="{Binding P4W}" Height="{Binding P4H}"
						  Visibility="{Binding P4Vis}" Opacity="{Binding P4Alpha}">
						<Border CornerRadius="10" Background="{Binding P4Fill}"/>
						<Image Source="{Binding P4Tex}" Stretch="UniformToFill"/>
						<TextBlock Text="{Binding P4Label}" Foreground="{Binding P4LabelColor}" FontSize="{Binding P4Font}" FontWeight="Bold"
								   HorizontalAlignment="Center" VerticalAlignment="Center"/>
						<Border CornerRadius="10" BorderBrush="{Binding P4Edge}" BorderThickness="{Binding P4EdgeWidth}"/>
					</Grid>
					<Grid Canvas.Left="{Binding P5X}" Canvas.Top="{Binding P5Y}" Width="{Binding P5W}" Height="{Binding P5H}"
						  Visibility="{Binding P5Vis}" Opacity="{Binding P5Alpha}">
						<Border CornerRadius="10" Background="{Binding P5Fill}"/>
						<Image Source="{Binding P5Tex}" Stretch="UniformToFill"/>
						<TextBlock Text="{Binding P5Label}" Foreground="{Binding P5LabelColor}" FontSize="{Binding P5Font}" FontWeight="Bold"
								   HorizontalAlignment="Center" VerticalAlignment="Center"/>
						<Border CornerRadius="10" BorderBrush="{Binding P5Edge}" BorderThickness="{Binding P5EdgeWidth}"/>
					</Grid>
					<Grid Canvas.Left="{Binding P6X}" Canvas.Top="{Binding P6Y}" Width="{Binding P6W}" Height="{Binding P6H}"
						  Visibility="{Binding P6Vis}" Opacity="{Binding P6Alpha}">
						<Border CornerRadius="10" Background="{Binding P6Fill}"/>
						<Image Source="{Binding P6Tex}" Stretch="UniformToFill"/>
						<TextBlock Text="{Binding P6Label}" Foreground="{Binding P6LabelColor}" FontSize="{Binding P6Font}" FontWeight="Bold"
								   HorizontalAlignment="Center" VerticalAlignment="Center"/>
						<Border CornerRadius="10" BorderBrush="{Binding P6Edge}" BorderThickness="{Binding P6EdgeWidth}"/>
					</Grid>
					<Grid Canvas.Left="{Binding P7X}" Canvas.Top="{Binding P7Y}" Width="{Binding P7W}" Height="{Binding P7H}"
						  Visibility="{Binding P7Vis}" Opacity="{Binding P7Alpha}">
						<Border CornerRadius="10" Background="{Binding P7Fill}"/>
						<Image Source="{Binding P7Tex}" Stretch="UniformToFill"/>
						<TextBlock Text="{Binding P7Label}" Foreground="{Binding P7LabelColor}" FontSize="{Binding P7Font}" FontWeight="Bold"
								   HorizontalAlignment="Center" VerticalAlignment="Center"/>
						<Border CornerRadius="10" BorderBrush="{Binding P7Edge}" BorderThickness="{Binding P7EdgeWidth}"/>
					</Grid>
					<Grid Canvas.Left="{Binding P8X}" Canvas.Top="{Binding P8Y}" Width="{Binding P8W}" Height="{Binding P8H}"
						  Visibility="{Binding P8Vis}" Opacity="{Binding P8Alpha}">
						<Border CornerRadius="10" Background="{Binding P8Fill}"/>
						<Image Source="{Binding P8Tex}" Stretch="UniformToFill"/>
						<TextBlock Text="{Binding P8Label}" Foreground="{Binding P8LabelColor}" FontSize="{Binding P8Font}" FontWeight="Bold"
								   HorizontalAlignment="Center" VerticalAlignment="Center"/>
						<Border CornerRadius="10" BorderBrush="{Binding P8Edge}" BorderThickness="{Binding P8EdgeWidth}"/>
					</Grid>
					<Grid Canvas.Left="{Binding P9X}" Canvas.Top="{Binding P9Y}" Width="{Binding P9W}" Height="{Binding P9H}"
						  Visibility="{Binding P9Vis}" Opacity="{Binding P9Alpha}">
						<Border CornerRadius="10" Background="{Binding P9Fill}"/>
						<Image Source="{Binding P9Tex}" Stretch="UniformToFill"/>
						<TextBlock Text="{Binding P9Label}" Foreground="{Binding P9LabelColor}" FontSize="{Binding P9Font}" FontWeight="Bold"
								   HorizontalAlignment="Center" VerticalAlignment="Center"/>
						<Border CornerRadius="10" BorderBrush="{Binding P9Edge}" BorderThickness="{Binding P9EdgeWidth}"/>
					</Grid>
					<Grid Canvas.Left="{Binding P10X}" Canvas.Top="{Binding P10Y}" Width="{Binding P10W}" Height="{Binding P10H}"
						  Visibility="{Binding P10Vis}" Opacity="{Binding P10Alpha}">
						<Border CornerRadius="10" Background="{Binding P10Fill}"/>
						<Image Source="{Binding P10Tex}" Stretch="UniformToFill"/>
						<TextBlock Text="{Binding P10Label}" Foreground="{Binding P10LabelColor}" FontSize="{Binding P10Font}" FontWeight="Bold"
								   HorizontalAlignment="Center" VerticalAlignment="Center"/>
						<Border CornerRadius="10" BorderBrush="{Binding P10Edge}" BorderThickness="{Binding P10EdgeWidth}"/>
					</Grid>
					<Grid Canvas.Left="{Binding P11X}" Canvas.Top="{Binding P11Y}" Width="{Binding P11W}" Height="{Binding P11H}"
						  Visibility="{Binding P11Vis}" Opacity="{Binding P11Alpha}">
						<Border CornerRadius="10" Background="{Binding P11Fill}"/>
						<Image Source="{Binding P11Tex}" Stretch="UniformToFill"/>
						<TextBlock Text="{Binding P11Label}" Foreground="{Binding P11LabelColor}" FontSize="{Binding P11Font}" FontWeight="Bold"
								   HorizontalAlignment="Center" VerticalAlignment="Center"/>
						<Border CornerRadius="10" BorderBrush="{Binding P11Edge}" BorderThickness="{Binding P11EdgeWidth}"/>
					</Grid>
					<Grid Canvas.Left="{Binding P12X}" Canvas.Top="{Binding P12Y}" Width="{Binding P12W}" Height="{Binding P12H}"
						  Visibility="{Binding P12Vis}" Opacity="{Binding P12Alpha}">
						<Border CornerRadius="10" Background="{Binding P12Fill}"/>
						<Image Source="{Binding P12Tex}" Stretch="UniformToFill"/>
						<TextBlock Text="{Binding P12Label}" Foreground="{Binding P12LabelColor}" FontSize="{Binding P12Font}" FontWeight="Bold"
								   HorizontalAlignment="Center" VerticalAlignment="Center"/>
						<Border CornerRadius="10" BorderBrush="{Binding P12Edge}" BorderThickness="{Binding P12EdgeWidth}"/>
					</Grid>
					<Grid Canvas.Left="{Binding P13X}" Canvas.Top="{Binding P13Y}" Width="{Binding P13W}" Height="{Binding P13H}"
						  Visibility="{Binding P13Vis}" Opacity="{Binding P13Alpha}">
						<Border CornerRadius="10" Background="{Binding P13Fill}"/>
						<Image Source="{Binding P13Tex}" Stretch="UniformToFill"/>
						<TextBlock Text="{Binding P13Label}" Foreground="{Binding P13LabelColor}" FontSize="{Binding P13Font}" FontWeight="Bold"
								   HorizontalAlignment="Center" VerticalAlignment="Center"/>
						<Border CornerRadius="10" BorderBrush="{Binding P13Edge}" BorderThickness="{Binding P13EdgeWidth}"/>
					</Grid>
					<Grid Canvas.Left="{Binding P14X}" Canvas.Top="{Binding P14Y}" Width="{Binding P14W}" Height="{Binding P14H}"
						  Visibility="{Binding P14Vis}" Opacity="{Binding P14Alpha}">
						<Border CornerRadius="10" Background="{Binding P14Fill}"/>
						<Image Source="{Binding P14Tex}" Stretch="UniformToFill"/>
						<TextBlock Text="{Binding P14Label}" Foreground="{Binding P14LabelColor}" FontSize="{Binding P14Font}" FontWeight="Bold"
								   HorizontalAlignment="Center" VerticalAlignment="Center"/>
						<Border CornerRadius="10" BorderBrush="{Binding P14Edge}" BorderThickness="{Binding P14EdgeWidth}"/>
					</Grid>
					<Grid Canvas.Left="{Binding P15X}" Canvas.Top="{Binding P15Y}" Width="{Binding P15W}" Height="{Binding P15H}"
						  Visibility="{Binding P15Vis}" Opacity="{Binding P15Alpha}">
						<Border CornerRadius="10" Background="{Binding P15Fill}"/>
						<Image Source="{Binding P15Tex}" Stretch="UniformToFill"/>
						<TextBlock Text="{Binding P15Label}" Foreground="{Binding P15LabelColor}" FontSize="{Binding P15Font}" FontWeight="Bold"
								   HorizontalAlignment="Center" VerticalAlignment="Center"/>
						<Border CornerRadius="10" BorderBrush="{Binding P15Edge}" BorderThickness="{Binding P15EdgeWidth}"/>
					</Grid>
					<Grid Canvas.Left="{Binding P16X}" Canvas.Top="{Binding P16Y}" Width="{Binding P16W}" Height="{Binding P16H}"
						  Visibility="{Binding P16Vis}" Opacity="{Binding P16Alpha}">
						<Border CornerRadius="10" Background="{Binding P16Fill}"/>
						<Image Source="{Binding P16Tex}" Stretch="UniformToFill"/>
						<TextBlock Text="{Binding P16Label}" Foreground="{Binding P16LabelColor}" FontSize="{Binding P16Font}" FontWeight="Bold"
								   HorizontalAlignment="Center" VerticalAlignment="Center"/>
						<Border CornerRadius="10" BorderBrush="{Binding P16Edge}" BorderThickness="{Binding P16EdgeWidth}"/>
					</Grid>
					<Grid Canvas.Left="{Binding P17X}" Canvas.Top="{Binding P17Y}" Width="{Binding P17W}" Height="{Binding P17H}"
						  Visibility="{Binding P17Vis}" Opacity="{Binding P17Alpha}">
						<Border CornerRadius="10" Background="{Binding P17Fill}"/>
						<Image Source="{Binding P17Tex}" Stretch="UniformToFill"/>
						<TextBlock Text="{Binding P17Label}" Foreground="{Binding P17LabelColor}" FontSize="{Binding P17Font}" FontWeight="Bold"
								   HorizontalAlignment="Center" VerticalAlignment="Center"/>
						<Border CornerRadius="10" BorderBrush="{Binding P17Edge}" BorderThickness="{Binding P17EdgeWidth}"/>
					</Grid>
					<Grid Canvas.Left="{Binding P18X}" Canvas.Top="{Binding P18Y}" Width="{Binding P18W}" Height="{Binding P18H}"
						  Visibility="{Binding P18Vis}" Opacity="{Binding P18Alpha}">
						<Border CornerRadius="10" Background="{Binding P18Fill}"/>
						<Image Source="{Binding P18Tex}" Stretch="UniformToFill"/>
						<TextBlock Text="{Binding P18Label}" Foreground="{Binding P18LabelColor}" FontSize="{Binding P18Font}" FontWeight="Bold"
								   HorizontalAlignment="Center" VerticalAlignment="Center"/>
						<Border CornerRadius="10" BorderBrush="{Binding P18Edge}" BorderThickness="{Binding P18EdgeWidth}"/>
					</Grid>
					<Grid Canvas.Left="{Binding P19X}" Canvas.Top="{Binding P19Y}" Width="{Binding P19W}" Height="{Binding P19H}"
						  Visibility="{Binding P19Vis}" Opacity="{Binding P19Alpha}">
						<Border CornerRadius="10" Background="{Binding P19Fill}"/>
						<Image Source="{Binding P19Tex}" Stretch="UniformToFill"/>
						<TextBlock Text="{Binding P19Label}" Foreground="{Binding P19LabelColor}" FontSize="{Binding P19Font}" FontWeight="Bold"
								   HorizontalAlignment="Center" VerticalAlignment="Center"/>
						<Border CornerRadius="10" BorderBrush="{Binding P19Edge}" BorderThickness="{Binding P19EdgeWidth}"/>
					</Grid>
					<Grid Canvas.Left="{Binding P20X}" Canvas.Top="{Binding P20Y}" Width="{Binding P20W}" Height="{Binding P20H}"
						  Visibility="{Binding P20Vis}" Opacity="{Binding P20Alpha}">
						<Border CornerRadius="10" Background="{Binding P20Fill}"/>
						<Image Source="{Binding P20Tex}" Stretch="UniformToFill"/>
						<TextBlock Text="{Binding P20Label}" Foreground="{Binding P20LabelColor}" FontSize="{Binding P20Font}" FontWeight="Bold"
								   HorizontalAlignment="Center" VerticalAlignment="Center"/>
						<Border CornerRadius="10" BorderBrush="{Binding P20Edge}" BorderThickness="{Binding P20EdgeWidth}"/>
					</Grid>
				</Canvas>
			</Grid>
		</Viewbox>
	</Grid>

	<!--
	  Aux area: tray or action button, side mini grid, Reset. Entering it with a piece in hand means
	  "left the board" - releasing here puts the piece back. (Not an Up trigger: a piece picked from
	  the tray would always release "here", because that is where its touch started.)
	-->
	<Grid Grid.Row="2" Background="Transparent">
		<b:Interaction.Triggers>
			<b:EventTrigger EventName="MouseEnter">
				<b:InvokeCommandAction Command="{Binding OnAuxEnter}"/>
			</b:EventTrigger>
			<b:EventTrigger EventName="TouchEnter">
				<b:InvokeCommandAction Command="{Binding OnAuxEnter}"/>
			</b:EventTrigger>
		</b:Interaction.Triggers>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="3*"/>
			<ColumnDefinition Width="94*"/>
			<ColumnDefinition Width="3*"/>
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="8*"/>
			<RowDefinition Height="84*"/>
			<RowDefinition Height="8*"/>
		</Grid.RowDefinitions>

		<Border Grid.Row="1" Grid.Column="1" Background="#FF1C1F2B" CornerRadius="14" Visibility="{Binding AuxVis}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="3*"/>
					<ColumnDefinition Width="52*"/>
					<ColumnDefinition Width="2*"/>
					<ColumnDefinition Width="20*"/>
					<ColumnDefinition Width="2*"/>
					<ColumnDefinition Width="18*"/>
					<ColumnDefinition Width="3*"/>
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="12*"/>
					<RowDefinition Height="76*"/>
					<RowDefinition Height="12*"/>
				</Grid.RowDefinitions>

				<!--
				  Tray: slots are 100 square and wrap at TrayWidth, so the script picks rows x columns
				  (up to 3 rows, whichever gives the biggest slot) and the Viewbox fits the result.
				  Two hosts: the wide one also takes the side grid's columns when there is no side grid.
				-->
				<Viewbox Grid.Row="1" Grid.Column="1" Stretch="Uniform" Visibility="{Binding TrayVis}">
					<ItemsControl Width="{Binding TrayWidth}" ItemsSource="{Binding Items}" ItemTemplate="{StaticResource TrayItem}">
						<ItemsControl.Template>
							<ControlTemplate TargetType="ItemsControl">
								<ItemsPresenter/>
							</ControlTemplate>
						</ItemsControl.Template>
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<WrapPanel/>
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
					</ItemsControl>
				</Viewbox>
				<Viewbox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Stretch="Uniform" Visibility="{Binding TrayWideVis}">
					<ItemsControl Width="{Binding TrayWidth}" ItemsSource="{Binding Items}" ItemTemplate="{StaticResource TrayItem}">
						<ItemsControl.Template>
							<ControlTemplate TargetType="ItemsControl">
								<ItemsPresenter/>
							</ControlTemplate>
						</ItemsControl.Template>
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<WrapPanel/>
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
					</ItemsControl>
				</Viewbox>

				<!-- Action button (colour fill's STOP): fires on press, not on release. -->
				<Button Grid.Row="1" Grid.Column="1" Style="{StaticResource BarButton}" Background="#FFE11D48" ClickMode="Press"
						Visibility="{Binding ActionVis}" Content="{Binding ActionLabel}" FontSize="{Binding BarFont}" Command="{Binding OnAction}"/>

				<Grid Grid.Row="1" Grid.Column="3" Visibility="{Binding SideVis}">
					<Grid.RowDefinitions>
						<RowDefinition Height="18*"/>
						<RowDefinition Height="82*"/>
					</Grid.RowDefinitions>
					<Viewbox Grid.Row="0" Stretch="Uniform">
						<TextBlock Text="{Binding SideLabel}" Foreground="#FF94A3B8" FontSize="20"/>
					</Viewbox>
					<Viewbox Grid.Row="1" Stretch="Uniform">
						<Grid Width="300" Height="300" IsHitTestVisible="False">
							<ItemsControl Width="{Binding SideWidth}" HorizontalAlignment="Center" VerticalAlignment="Center" ItemsSource="{Binding SideCells}" ItemTemplate="{StaticResource SideCell}">
								<ItemsControl.Template>
									<ControlTemplate TargetType="ItemsControl">
										<ItemsPresenter/>
									</ControlTemplate>
								</ItemsControl.Template>
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<WrapPanel/>
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
							</ItemsControl>
						</Grid>
					</Viewbox>
				</Grid>

				<Button Grid.Row="1" Grid.Column="5" Style="{StaticResource BarButton}" Background="#FF52576B"
						Content="Reset" FontSize="{Binding BarFont}" Command="{Binding OnReset}"/>
			</Grid>
		</Border>

		<!-- Level start banner: takes the aux area's place while it shows. -->
		<Border Grid.Row="1" Grid.Column="1" Background="#FF1C1F2B" CornerRadius="14" IsHitTestVisible="False"
				Visibility="{Binding IntroVis}" Opacity="{Binding IntroAlpha}">
			<Viewbox Stretch="Uniform" Margin="20">
				<TextBlock Text="{Binding IntroText}" Foreground="#FFF2CC40" FontSize="40" FontWeight="Bold"/>
			</Viewbox>
		</Border>
	</Grid>

	<!-- Bottom inset: Menu (pause). The hub's own bar is covered while the board is up. -->
	<Grid Grid.Row="3">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="75*"/>
			<ColumnDefinition Width="22*"/>
			<ColumnDefinition Width="3*"/>
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="14*"/>
			<RowDefinition Height="72*"/>
			<RowDefinition Height="14*"/>
		</Grid.RowDefinitions>
		<Button Grid.Row="1" Grid.Column="1" Style="{StaticResource BarButton}" Background="#FF3D455C" Opacity="0.92"
				Content="Menu" FontSize="{Binding BarFont}" Command="{Binding OnMenu}"/>
	</Grid>
</Grid>
