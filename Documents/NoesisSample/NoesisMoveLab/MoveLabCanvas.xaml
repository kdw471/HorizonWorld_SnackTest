<!--
  NoesisMoveLab (canvas positioning) - Rush Hour dragged BY THE SCRIPT from pointer coordinates.
  GENERATED: edit Documents/Tools/build_noesis_movelab_xaml.js and run it again, do not edit this file.

  The root passes Down / Move / Up to the script with PassEventArgsToCommand="True" (args.position).
  Nothing on the board takes input: the script decides which piece was grabbed from the coordinates
  and moves it by writing the piece's position. Script: NoesisMoveLab_Panel.ts (the same one for
  all three pages, so only the gizmo's Root XAML changes).
-->
<Grid
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
	x:Name="Root" Background="#FF14171F">

	<Grid.Resources>
		<Style x:Key="BarButton" TargetType="Button">
			<Setter Property="Foreground" Value="#FFFFFFFF"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="CellBox" TargetType="Border">
			<Setter Property="Margin" Value="1.5"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Background" Value="#FF1F212E"/>
		</Style>

		<Style x:Key="PortBase" TargetType="Border">
			<Setter Property="Margin" Value="1.5"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Background" Value="#FF0B0D12"/>
		</Style>
		<Style x:Key="PortRed" TargetType="Border" BasedOn="{StaticResource PortBase}">
			<Setter Property="Background" Value="#40E11D48"/>
			<Setter Property="BorderBrush" Value="#FFE11D48"/>
			<Setter Property="BorderThickness" Value="4"/>
		</Style>
		<Style x:Key="PortBlue" TargetType="Border" BasedOn="{StaticResource PortBase}">
			<Setter Property="Background" Value="#403B82F6"/>
			<Setter Property="BorderBrush" Value="#FF3B82F6"/>
			<Setter Property="BorderThickness" Value="4"/>
		</Style>

		<Style x:Key="FaceBlock" TargetType="Border">
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="Background" Value="#FF64748B"/>
			<Setter Property="BorderBrush" Value="#FF94A3B8"/>
			<Setter Property="BorderThickness" Value="3"/>
		</Style>
		<Style x:Key="FaceRed" TargetType="Border" BasedOn="{StaticResource FaceBlock}">
			<Setter Property="Background" Value="#FFE11D48"/>
			<Setter Property="BorderBrush" Value="#FFFDA4AF"/>
		</Style>
		<Style x:Key="FaceBlue" TargetType="Border" BasedOn="{StaticResource FaceBlock}">
			<Setter Property="Background" Value="#FF3B82F6"/>
			<Setter Property="BorderBrush" Value="#FF93C5FD"/>
		</Style>
		<!-- The grabbed piece: a bright rim on top of whatever face it has. -->
		<Style x:Key="FaceHot" TargetType="Border">
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="BorderBrush" Value="#FFFFF299"/>
			<Setter Property="BorderThickness" Value="5"/>
		</Style>
		<Style x:Key="PieceLabel" TargetType="TextBlock">
			<Setter Property="Foreground" Value="#FFFFFFFF"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
	</Grid.Resources>

	<!--
	  Pointer events with their arguments. Mouse and Touch go to separate commands so the script can
	  show which ones arrive on a phone and what their arguments look like; whichever source grabs a
	  piece first drives that drag.
	-->
	<b:Interaction.Triggers>
		<b:EventTrigger EventName="MouseLeftButtonDown">
			<b:InvokeCommandAction Command="{Binding OnMouseDown}" PassEventArgsToCommand="True"/>
		</b:EventTrigger>
		<b:EventTrigger EventName="MouseMove">
			<b:InvokeCommandAction Command="{Binding OnMouseMove}" PassEventArgsToCommand="True"/>
		</b:EventTrigger>
		<b:EventTrigger EventName="MouseLeftButtonUp">
			<b:InvokeCommandAction Command="{Binding OnMouseUp}" PassEventArgsToCommand="True"/>
		</b:EventTrigger>
		<b:EventTrigger EventName="TouchDown">
			<b:InvokeCommandAction Command="{Binding OnTouchDown}" PassEventArgsToCommand="True"/>
		</b:EventTrigger>
		<b:EventTrigger EventName="TouchMove">
			<b:InvokeCommandAction Command="{Binding OnTouchMove}" PassEventArgsToCommand="True"/>
		</b:EventTrigger>
		<b:EventTrigger EventName="TouchUp">
			<b:InvokeCommandAction Command="{Binding OnTouchUp}" PassEventArgsToCommand="True"/>
		</b:EventTrigger>
		<b:EventTrigger EventName="Loaded">
			<b:InvokeCommandAction Command="{Binding OnRootWidth}" CommandParameter="{Binding ActualWidth, ElementName=Root}"/>
			<b:InvokeCommandAction Command="{Binding OnRootHeight}" CommandParameter="{Binding ActualHeight, ElementName=Root}"/>
		</b:EventTrigger>
		<b:EventTrigger EventName="SizeChanged">
			<b:InvokeCommandAction Command="{Binding OnRootWidth}" CommandParameter="{Binding ActualWidth, ElementName=Root}"/>
			<b:InvokeCommandAction Command="{Binding OnRootHeight}" CommandParameter="{Binding ActualHeight, ElementName=Root}"/>
		</b:EventTrigger>
		<b:EventTrigger EventName="PreviewMouseLeftButtonDown">
			<b:InvokeCommandAction Command="{Binding OnRootWidth}" CommandParameter="{Binding ActualWidth, ElementName=Root}"/>
			<b:InvokeCommandAction Command="{Binding OnRootHeight}" CommandParameter="{Binding ActualHeight, ElementName=Root}"/>
		</b:EventTrigger>
	</b:Interaction.Triggers>

	<Grid.RowDefinitions>
		<RowDefinition Height="6*"/>
		<RowDefinition Height="60.2*"/>
		<RowDefinition Height="25.8*"/>
		<RowDefinition Height="8*"/>
	</Grid.RowDefinitions>

	<!-- Top inset: title and move count. -->
	<Grid Grid.Row="0" IsHitTestVisible="False">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="3*"/>
			<ColumnDefinition Width="94*"/>
			<ColumnDefinition Width="3*"/>
		</Grid.ColumnDefinitions>
		<TextBlock Grid.Column="1" Text="{Binding TitleText}" FontSize="{Binding FontLarge}" FontWeight="Bold"
				   Foreground="#FFFFFFFF" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
		<TextBlock Grid.Column="1" Text="{Binding MovesText}" FontSize="{Binding FontLarge}" FontWeight="Bold"
				   Foreground="#FFF2CC40" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
	</Grid>

	<!-- Aux area: hint, update-rate button, Reset. -->
	<Grid Grid.Row="2">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="3*"/>
			<ColumnDefinition Width="94*"/>
			<ColumnDefinition Width="3*"/>
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="8*"/>
			<RowDefinition Height="84*"/>
			<RowDefinition Height="8*"/>
		</Grid.RowDefinitions>
		<Border Grid.Row="1" Grid.Column="1" Background="#FF1C1F2B" CornerRadius="14">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="4*"/>
					<ColumnDefinition Width="44*"/>
					<ColumnDefinition Width="2*"/>
					<ColumnDefinition Width="26*"/>
					<ColumnDefinition Width="2*"/>
					<ColumnDefinition Width="18*"/>
					<ColumnDefinition Width="4*"/>
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="15*"/>
					<RowDefinition Height="70*"/>
					<RowDefinition Height="15*"/>
				</Grid.RowDefinitions>
				<TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding HintText}" FontSize="{Binding FontMedium}"
						   Foreground="#FFCBD5E1" TextWrapping="Wrap" VerticalAlignment="Center" IsHitTestVisible="False"/>
				<Button Grid.Row="1" Grid.Column="3" Style="{StaticResource BarButton}" Background="#FF3D455C"
						Content="{Binding RateLabel}" FontSize="{Binding FontSmall}" Command="{Binding OnRate}"/>
				<Button Grid.Row="1" Grid.Column="5" Style="{StaticResource BarButton}" Background="#FF52576B"
						Content="Reset" FontSize="{Binding FontMedium}" Command="{Binding OnReset}"/>
			</Grid>
		</Border>
	</Grid>

	<!-- Bottom inset: diagnostics - root size, move events per second, last position, first args per event kind. -->
	<TextBlock Grid.Row="3" Margin="12,2,12,2" Text="{Binding DiagText}" FontSize="{Binding FontSmall}"
			   Foreground="#FF94A3B8" TextWrapping="Wrap" VerticalAlignment="Center" IsHitTestVisible="False"/>

	<!-- Board layer: placed by the script in root pixels. A picture only - the root takes all the input. -->
	<Canvas Grid.RowSpan="4" IsHitTestVisible="False">
		<Border Canvas.Left="{Binding BoardX}" Canvas.Top="{Binding BoardY}" Width="{Binding BoardSize}" Height="{Binding BoardSize}"
				Background="#FF0E1017" CornerRadius="10">
			<UniformGrid Rows="7" Columns="7">
				<Border Style="{StaticResource CellBox}"/>
				<Border Style="{StaticResource CellBox}"/>
				<Border Style="{StaticResource CellBox}"/>
				<Border Style="{StaticResource CellBox}"/>
				<Border Style="{StaticResource CellBox}"/>
				<Border Style="{StaticResource CellBox}"/>
				<Border Style="{StaticResource CellBox}"/>
				<Border Style="{StaticResource CellBox}"/>
				<Border Style="{StaticResource CellBox}"/>
				<Border Style="{StaticResource CellBox}"/>
				<Border Style="{StaticResource CellBox}"/>
				<Border Style="{StaticResource CellBox}"/>
				<Border Style="{StaticResource CellBox}"/>
				<Border Style="{StaticResource CellBox}"/>
				<Border Style="{StaticResource CellBox}"/>
				<Border Style="{StaticResource CellBox}"/>
				<Border Style="{StaticResource CellBox}"/>
				<Border Style="{StaticResource CellBox}"/>
				<Border Style="{StaticResource CellBox}"/>
				<Border Style="{StaticResource CellBox}"/>
				<Border Style="{StaticResource CellBox}"/>
				<Border Style="{StaticResource CellBox}"/>
				<Border Style="{StaticResource CellBox}"/>
				<Border Style="{StaticResource CellBox}"/>
				<Border Style="{StaticResource CellBox}"/>
				<Border Style="{StaticResource CellBox}"/>
				<Border Style="{StaticResource CellBox}"/>
				<Border Style="{StaticResource CellBox}"/>
				<Border Style="{StaticResource CellBox}"/>
				<Border Style="{StaticResource CellBox}"/>
				<Border Style="{StaticResource CellBox}"/>
				<Border Style="{StaticResource CellBox}"/>
				<Border Style="{StaticResource CellBox}"/>
				<Border Style="{StaticResource CellBox}"/>
				<Border Style="{StaticResource CellBox}"/>
				<Border Style="{StaticResource CellBox}"/>
				<Border Style="{StaticResource CellBox}"/>
				<Border Style="{StaticResource CellBox}"/>
				<Border Style="{StaticResource CellBox}"/>
				<Border Style="{StaticResource CellBox}"/>
				<Border Style="{StaticResource CellBox}"/>
				<Border Style="{StaticResource CellBox}"/>
				<Border Style="{StaticResource CellBox}"/>
				<Border Style="{StaticResource CellBox}"/>
				<Border Style="{StaticResource CellBox}"/>
				<Border Style="{StaticResource CellBox}"/>
				<Border Style="{StaticResource CellBox}"/>
				<Border Style="{StaticResource CellBox}"/>
				<Border Style="{StaticResource CellBox}"/>
			</UniformGrid>
		</Border>

		<Grid Canvas.Left="{Binding E1X}" Canvas.Top="{Binding E1Y}" Width="{Binding E1Size}" Height="{Binding E1Size}">
			<Border Style="{StaticResource PortBase}"/>
			<Border Style="{StaticResource PortRed}" Opacity="{Binding E1Red}"/>
			<Border Style="{StaticResource PortBlue}" Opacity="{Binding E1Blue}"/>
		</Grid>
		<Grid Canvas.Left="{Binding E2X}" Canvas.Top="{Binding E2Y}" Width="{Binding E2Size}" Height="{Binding E2Size}">
			<Border Style="{StaticResource PortBase}"/>
			<Border Style="{StaticResource PortRed}" Opacity="{Binding E2Red}"/>
			<Border Style="{StaticResource PortBlue}" Opacity="{Binding E2Blue}"/>
		</Grid>

		<Grid Canvas.Left="{Binding P1X}" Canvas.Top="{Binding P1Y}" Width="{Binding P1W}" Height="{Binding P1H}">
			<Border Style="{StaticResource FaceBlock}"/>
			<Border Style="{StaticResource FaceRed}" Opacity="{Binding P1Red}"/>
			<Border Style="{StaticResource FaceBlue}" Opacity="{Binding P1Blue}"/>
			<Border Style="{StaticResource FaceHot}" Opacity="{Binding P1Hot}"/>
			<TextBlock Style="{StaticResource PieceLabel}" Text="{Binding P1Label}" FontSize="{Binding FontMedium}"/>
		</Grid>
		<Grid Canvas.Left="{Binding P2X}" Canvas.Top="{Binding P2Y}" Width="{Binding P2W}" Height="{Binding P2H}">
			<Border Style="{StaticResource FaceBlock}"/>
			<Border Style="{StaticResource FaceRed}" Opacity="{Binding P2Red}"/>
			<Border Style="{StaticResource FaceBlue}" Opacity="{Binding P2Blue}"/>
			<Border Style="{StaticResource FaceHot}" Opacity="{Binding P2Hot}"/>
			<TextBlock Style="{StaticResource PieceLabel}" Text="{Binding P2Label}" FontSize="{Binding FontMedium}"/>
		</Grid>
		<Grid Canvas.Left="{Binding P3X}" Canvas.Top="{Binding P3Y}" Width="{Binding P3W}" Height="{Binding P3H}">
			<Border Style="{StaticResource FaceBlock}"/>
			<Border Style="{StaticResource FaceRed}" Opacity="{Binding P3Red}"/>
			<Border Style="{StaticResource FaceBlue}" Opacity="{Binding P3Blue}"/>
			<Border Style="{StaticResource FaceHot}" Opacity="{Binding P3Hot}"/>
			<TextBlock Style="{StaticResource PieceLabel}" Text="{Binding P3Label}" FontSize="{Binding FontMedium}"/>
		</Grid>
		<Grid Canvas.Left="{Binding P4X}" Canvas.Top="{Binding P4Y}" Width="{Binding P4W}" Height="{Binding P4H}">
			<Border Style="{StaticResource FaceBlock}"/>
			<Border Style="{StaticResource FaceRed}" Opacity="{Binding P4Red}"/>
			<Border Style="{StaticResource FaceBlue}" Opacity="{Binding P4Blue}"/>
			<Border Style="{StaticResource FaceHot}" Opacity="{Binding P4Hot}"/>
			<TextBlock Style="{StaticResource PieceLabel}" Text="{Binding P4Label}" FontSize="{Binding FontMedium}"/>
		</Grid>
		<Grid Canvas.Left="{Binding P5X}" Canvas.Top="{Binding P5Y}" Width="{Binding P5W}" Height="{Binding P5H}">
			<Border Style="{StaticResource FaceBlock}"/>
			<Border Style="{StaticResource FaceRed}" Opacity="{Binding P5Red}"/>
			<Border Style="{StaticResource FaceBlue}" Opacity="{Binding P5Blue}"/>
			<Border Style="{StaticResource FaceHot}" Opacity="{Binding P5Hot}"/>
			<TextBlock Style="{StaticResource PieceLabel}" Text="{Binding P5Label}" FontSize="{Binding FontMedium}"/>
		</Grid>
		<Grid Canvas.Left="{Binding P6X}" Canvas.Top="{Binding P6Y}" Width="{Binding P6W}" Height="{Binding P6H}">
			<Border Style="{StaticResource FaceBlock}"/>
			<Border Style="{StaticResource FaceRed}" Opacity="{Binding P6Red}"/>
			<Border Style="{StaticResource FaceBlue}" Opacity="{Binding P6Blue}"/>
			<Border Style="{StaticResource FaceHot}" Opacity="{Binding P6Hot}"/>
			<TextBlock Style="{StaticResource PieceLabel}" Text="{Binding P6Label}" FontSize="{Binding FontMedium}"/>
		</Grid>
		<Grid Canvas.Left="{Binding P7X}" Canvas.Top="{Binding P7Y}" Width="{Binding P7W}" Height="{Binding P7H}">
			<Border Style="{StaticResource FaceBlock}"/>
			<Border Style="{StaticResource FaceRed}" Opacity="{Binding P7Red}"/>
			<Border Style="{StaticResource FaceBlue}" Opacity="{Binding P7Blue}"/>
			<Border Style="{StaticResource FaceHot}" Opacity="{Binding P7Hot}"/>
			<TextBlock Style="{StaticResource PieceLabel}" Text="{Binding P7Label}" FontSize="{Binding FontMedium}"/>
		</Grid>
		<Grid Canvas.Left="{Binding P8X}" Canvas.Top="{Binding P8Y}" Width="{Binding P8W}" Height="{Binding P8H}">
			<Border Style="{StaticResource FaceBlock}"/>
			<Border Style="{StaticResource FaceRed}" Opacity="{Binding P8Red}"/>
			<Border Style="{StaticResource FaceBlue}" Opacity="{Binding P8Blue}"/>
			<Border Style="{StaticResource FaceHot}" Opacity="{Binding P8Hot}"/>
			<TextBlock Style="{StaticResource PieceLabel}" Text="{Binding P8Label}" FontSize="{Binding FontMedium}"/>
		</Grid>
		<Grid Canvas.Left="{Binding P9X}" Canvas.Top="{Binding P9Y}" Width="{Binding P9W}" Height="{Binding P9H}">
			<Border Style="{StaticResource FaceBlock}"/>
			<Border Style="{StaticResource FaceRed}" Opacity="{Binding P9Red}"/>
			<Border Style="{StaticResource FaceBlue}" Opacity="{Binding P9Blue}"/>
			<Border Style="{StaticResource FaceHot}" Opacity="{Binding P9Hot}"/>
			<TextBlock Style="{StaticResource PieceLabel}" Text="{Binding P9Label}" FontSize="{Binding FontMedium}"/>
		</Grid>
		<Grid Canvas.Left="{Binding P10X}" Canvas.Top="{Binding P10Y}" Width="{Binding P10W}" Height="{Binding P10H}">
			<Border Style="{StaticResource FaceBlock}"/>
			<Border Style="{StaticResource FaceRed}" Opacity="{Binding P10Red}"/>
			<Border Style="{StaticResource FaceBlue}" Opacity="{Binding P10Blue}"/>
			<Border Style="{StaticResource FaceHot}" Opacity="{Binding P10Hot}"/>
			<TextBlock Style="{StaticResource PieceLabel}" Text="{Binding P10Label}" FontSize="{Binding FontMedium}"/>
		</Grid>
		<Grid Canvas.Left="{Binding P11X}" Canvas.Top="{Binding P11Y}" Width="{Binding P11W}" Height="{Binding P11H}">
			<Border Style="{StaticResource FaceBlock}"/>
			<Border Style="{StaticResource FaceRed}" Opacity="{Binding P11Red}"/>
			<Border Style="{StaticResource FaceBlue}" Opacity="{Binding P11Blue}"/>
			<Border Style="{StaticResource FaceHot}" Opacity="{Binding P11Hot}"/>
			<TextBlock Style="{StaticResource PieceLabel}" Text="{Binding P11Label}" FontSize="{Binding FontMedium}"/>
		</Grid>
		<Grid Canvas.Left="{Binding P12X}" Canvas.Top="{Binding P12Y}" Width="{Binding P12W}" Height="{Binding P12H}">
			<Border Style="{StaticResource FaceBlock}"/>
			<Border Style="{StaticResource FaceRed}" Opacity="{Binding P12Red}"/>
			<Border Style="{StaticResource FaceBlue}" Opacity="{Binding P12Blue}"/>
			<Border Style="{StaticResource FaceHot}" Opacity="{Binding P12Hot}"/>
			<TextBlock Style="{StaticResource PieceLabel}" Text="{Binding P12Label}" FontSize="{Binding FontMedium}"/>
		</Grid>

		<Border Canvas.Left="{Binding BoardX}" Canvas.Top="{Binding BoardY}" Width="{Binding BannerSize}" Height="{Binding BannerSize}"
				Background="#B30A0C12" CornerRadius="10">
			<TextBlock Text="{Binding BannerText}" FontSize="{Binding FontLarge}" FontWeight="Bold" Foreground="#FFF2CC40"
					   HorizontalAlignment="Center" VerticalAlignment="Center"/>
		</Border>
	</Canvas>
</Grid>
