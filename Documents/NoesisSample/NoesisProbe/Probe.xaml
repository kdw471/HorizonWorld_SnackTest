<!--
  NoesisProbe - phase 0 checks for the full Noesis migration. Script: NoesisProbe_Panel.ts.

  The root is transparent on purpose (T6): run it together with the Custom UI main panel and
  see which one draws on top and which one gets the input.

  Everything sits in a 360 x 640 design inside a Viewbox. The frame (columns 3/94/3, rows
  12/76/12), the design size and the yard position (8, 418, 40 px slots) are mirrored as
  constants in the script - change both together.
-->
<Grid
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
	x:Name="Root">

	<Grid.Resources>
		<Style x:Key="ProbeButton" TargetType="Button">
			<Setter Property="Foreground" Value="#FFFFFFFF"/>
			<Setter Property="FontSize" Value="10"/>
			<Setter Property="Margin" Value="0,0,4,0"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Bd" Background="#FF3D455C" CornerRadius="5" Padding="7,4">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="#FF64748B"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="Caption" TargetType="TextBlock">
			<Setter Property="Foreground" Value="#FF94A3B8"/>
			<Setter Property="FontSize" Value="8"/>
		</Style>

		<Style x:Key="YardSlot" TargetType="Border">
			<Setter Property="Margin" Value="1"/>
			<Setter Property="CornerRadius" Value="4"/>
			<Setter Property="Background" Value="#FF1F212E"/>
		</Style>

		<!-- T3: two colour layers, so the grid shows up whichever colour binding works. -->
		<DataTemplate x:Key="ProbeCell">
			<Grid Width="32" Height="32">
				<Border Margin="1" CornerRadius="3" Background="{Binding Fill}"/>
				<Border Margin="1" CornerRadius="3">
					<Border.Background>
						<SolidColorBrush Color="{Binding Fill}"/>
					</Border.Background>
				</Border>
				<Image Margin="3" Source="{Binding Tex}" Stretch="Uniform"/>
				<TextBlock Text="{Binding Label}" Foreground="#FFFFFFFF" FontSize="9"
						   HorizontalAlignment="Center" VerticalAlignment="Center"/>
			</Grid>
		</DataTemplate>

		<!-- T4: X / Y bound TwoWay to properties of an array item. -->
		<DataTemplate x:Key="ProbePiece">
			<Grid Width="{Binding Size}" Height="{Binding Size}" Background="Transparent">
				<b:Interaction.Behaviors>
					<b:MouseDragElementBehavior X="{Binding X, Mode=TwoWay}" Y="{Binding Y, Mode=TwoWay}"/>
				</b:Interaction.Behaviors>
				<b:Interaction.Triggers>
					<b:EventTrigger EventName="MouseLeftButtonUp">
						<b:InvokeCommandAction Command="{Binding OnUp}"/>
					</b:EventTrigger>
					<b:EventTrigger EventName="TouchUp">
						<b:InvokeCommandAction Command="{Binding OnUp}"/>
					</b:EventTrigger>
					<b:EventTrigger EventName="LostMouseCapture">
						<b:InvokeCommandAction Command="{Binding OnUp}"/>
					</b:EventTrigger>
				</b:Interaction.Triggers>
				<Border CornerRadius="6" BorderBrush="#FFFFFFFF" BorderThickness="1.5" IsHitTestVisible="False">
					<Border.Background>
						<SolidColorBrush Color="{Binding Fill}"/>
					</Border.Background>
				</Border>
				<Border CornerRadius="6" Background="{Binding Fill}" BorderBrush="#FFFFFFFF" BorderThickness="1.5" IsHitTestVisible="False"/>
				<TextBlock Text="{Binding Label}" Foreground="#FFFFFFFF" FontSize="11" FontWeight="Bold"
						   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
			</Grid>
		</DataTemplate>
	</Grid.Resources>

	<b:Interaction.Triggers>
		<b:EventTrigger EventName="Loaded">
			<b:InvokeCommandAction Command="{Binding OnRootWidth}" CommandParameter="{Binding ActualWidth, ElementName=Root}"/>
			<b:InvokeCommandAction Command="{Binding OnRootHeight}" CommandParameter="{Binding ActualHeight, ElementName=Root}"/>
		</b:EventTrigger>
		<b:EventTrigger EventName="SizeChanged">
			<b:InvokeCommandAction Command="{Binding OnRootWidth}" CommandParameter="{Binding ActualWidth, ElementName=Root}"/>
			<b:InvokeCommandAction Command="{Binding OnRootHeight}" CommandParameter="{Binding ActualHeight, ElementName=Root}"/>
		</b:EventTrigger>
		<b:EventTrigger EventName="PreviewMouseLeftButtonDown">
			<b:InvokeCommandAction Command="{Binding OnRootWidth}" CommandParameter="{Binding ActualWidth, ElementName=Root}"/>
			<b:InvokeCommandAction Command="{Binding OnRootHeight}" CommandParameter="{Binding ActualHeight, ElementName=Root}"/>
		</b:EventTrigger>
	</b:Interaction.Triggers>

	<Grid.ColumnDefinitions>
		<ColumnDefinition Width="3*"/>
		<ColumnDefinition Width="94*"/>
		<ColumnDefinition Width="3*"/>
	</Grid.ColumnDefinitions>
	<Grid.RowDefinitions>
		<RowDefinition Height="12*"/>
		<RowDefinition Height="76*"/>
		<RowDefinition Height="12*"/>
	</Grid.RowDefinitions>

	<Viewbox Grid.Row="1" Grid.Column="1" Stretch="Uniform">
		<Grid Width="360" Height="640">
			<Border Background="#F014171F" CornerRadius="10"/>

			<Canvas>
				<TextBlock Canvas.Left="8" Canvas.Top="4" Text="Noesis Probe" Foreground="#FFFFFFFF" FontSize="12" FontWeight="Bold"/>
				<TextBlock Canvas.Left="100" Canvas.Top="4" Width="252" Text="{Binding Status}" Foreground="#FF94A3B8" FontSize="8" TextWrapping="Wrap"/>

				<!-- T1 colour + visibility -->
				<TextBlock Canvas.Left="8" Canvas.Top="30" Style="{StaticResource Caption}" Text="T1  Background=Binding"/>
				<Border Canvas.Left="8" Canvas.Top="42" Width="60" Height="22" CornerRadius="4" Background="{Binding FillText}" BorderBrush="#FF52576B" BorderThickness="1"/>
				<TextBlock Canvas.Left="110" Canvas.Top="30" Style="{StaticResource Caption}" Text="Brush.Color=Binding"/>
				<Border Canvas.Left="110" Canvas.Top="42" Width="60" Height="22" CornerRadius="4" BorderBrush="#FF52576B" BorderThickness="1">
					<Border.Background>
						<SolidColorBrush Color="{Binding FillColor}"/>
					</Border.Background>
				</Border>
				<TextBlock Canvas.Left="196" Canvas.Top="30" Style="{StaticResource Caption}" Text="Visibility=Binding"/>
				<Border Canvas.Left="196" Canvas.Top="42" Width="40" Height="22" CornerRadius="4" Background="#FFF2CC40" Visibility="{Binding Vis}"/>
				<StackPanel Canvas.Left="250" Canvas.Top="42" Orientation="Horizontal">
					<Button Style="{StaticResource ProbeButton}" Content="colour" Command="{Binding OnCycleColor}"/>
					<Button Style="{StaticResource ProbeButton}" Content="vis" Command="{Binding OnToggleVis}"/>
				</StackPanel>

				<!-- T2 texture -->
				<TextBlock Canvas.Left="8" Canvas.Top="70" Style="{StaticResource Caption}" Text="T2  set at start"/>
				<Border Canvas.Left="8" Canvas.Top="82" Width="36" Height="36" Background="#FF1F212E" CornerRadius="4">
					<Image Source="{Binding TexEarly}" Stretch="Uniform"/>
				</Border>
				<TextBlock Canvas.Left="110" Canvas.Top="70" Style="{StaticResource Caption}" Text="null at start, set later"/>
				<Border Canvas.Left="110" Canvas.Top="82" Width="36" Height="36" Background="#FF1F212E" CornerRadius="4">
					<Image Source="{Binding TexLate}" Stretch="Uniform"/>
				</Border>
				<Button Canvas.Left="250" Canvas.Top="88" Style="{StaticResource ProbeButton}" Content="load late" Command="{Binding OnLoadLate}"/>

				<!-- T3 81 cells -->
				<ItemsControl Canvas.Left="8" Canvas.Top="124" Width="288" Height="288"
							  ItemsSource="{Binding Cells}" ItemTemplate="{StaticResource ProbeCell}">
					<ItemsControl.Template>
						<ControlTemplate TargetType="ItemsControl">
							<ItemsPresenter/>
						</ControlTemplate>
					</ItemsControl.Template>
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<UniformGrid Rows="9" Columns="9"/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
				</ItemsControl>
				<TextBlock Canvas.Left="302" Canvas.Top="124" Style="{StaticResource Caption}" Text="T3"/>
				<Button Canvas.Left="302" Canvas.Top="138" Width="52" Style="{StaticResource ProbeButton}" Content="repaint" Command="{Binding OnRepaintAll}"/>
				<Button Canvas.Left="302" Canvas.Top="166" Width="52" Style="{StaticResource ProbeButton}" Content="{Binding AutoLabel}" Command="{Binding OnToggleAuto}"/>

				<!-- Yard: 8 x 2 slots of 40 px at (8, 418). A picture only. -->
				<TextBlock Canvas.Left="332" Canvas.Top="404" Style="{StaticResource Caption}" Text="T4 T5"/>
				<UniformGrid Canvas.Left="8" Canvas.Top="418" Width="320" Height="80" Rows="2" Columns="8" IsHitTestVisible="False">
					<Border Style="{StaticResource YardSlot}"/>
					<Border Style="{StaticResource YardSlot}"/>
					<Border Style="{StaticResource YardSlot}"/>
					<Border Style="{StaticResource YardSlot}"/>
					<Border Style="{StaticResource YardSlot}"/>
					<Border Style="{StaticResource YardSlot}"/>
					<Border Style="{StaticResource YardSlot}"/>
					<Border Style="{StaticResource YardSlot}"/>
					<Border Style="{StaticResource YardSlot}"/>
					<Border Style="{StaticResource YardSlot}"/>
					<Border Style="{StaticResource YardSlot}"/>
					<Border Style="{StaticResource YardSlot}"/>
					<Border Style="{StaticResource YardSlot}"/>
					<Border Style="{StaticResource YardSlot}"/>
					<Border Style="{StaticResource YardSlot}"/>
					<Border Style="{StaticResource YardSlot}"/>
				</UniformGrid>

				<TextBlock Canvas.Left="8" Canvas.Top="506" Width="344" Text="{Binding Log}" Foreground="#FFE2E8F0" FontSize="8.5" TextWrapping="Wrap"/>

				<!-- T5: flat-key piece (P1X / P1Y), the known-good baseline. -->
				<Grid Width="36" Height="36" Background="Transparent">
					<b:Interaction.Behaviors>
						<b:MouseDragElementBehavior X="{Binding P1X, Mode=TwoWay}" Y="{Binding P1Y, Mode=TwoWay}"/>
					</b:Interaction.Behaviors>
					<b:Interaction.Triggers>
						<b:EventTrigger EventName="MouseLeftButtonUp">
							<b:InvokeCommandAction Command="{Binding OnP1Up}"/>
						</b:EventTrigger>
						<b:EventTrigger EventName="TouchUp">
							<b:InvokeCommandAction Command="{Binding OnP1Up}"/>
						</b:EventTrigger>
						<b:EventTrigger EventName="LostMouseCapture">
							<b:InvokeCommandAction Command="{Binding OnP1Up}"/>
						</b:EventTrigger>
					</b:Interaction.Triggers>
					<Border CornerRadius="6" Background="#FFE11D48" BorderBrush="#FFFFFFFF" BorderThickness="1.5" IsHitTestVisible="False"/>
					<TextBlock Text="P1" Foreground="#FFFFFFFF" FontSize="11" FontWeight="Bold"
							   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
				</Grid>
			</Canvas>

			<!-- T4: pieces generated from an array. -->
			<ItemsControl ItemsSource="{Binding Pieces}" ItemTemplate="{StaticResource ProbePiece}">
				<ItemsControl.Template>
					<ControlTemplate TargetType="ItemsControl">
						<ItemsPresenter/>
					</ControlTemplate>
				</ItemsControl.Template>
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<Canvas/>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
			</ItemsControl>
		</Grid>
	</Viewbox>
</Grid>
