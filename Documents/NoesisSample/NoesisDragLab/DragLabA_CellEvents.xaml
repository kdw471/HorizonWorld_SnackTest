<!--
  NoesisDragLab - page A: cell events.
  Every cell reports Down / Enter / Up to the script (NoesisDragLab_Panel.ts) as commands.
  The script owns the board; this page only draws what the dataContext says.
  Styles are written out in full so the page does not depend on a Noesis theme being loaded.
-->
<Grid
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
	Background="#E6101418">

	<Grid.Resources>
		<Style x:Key="LabButton" TargetType="Button">
			<Setter Property="Foreground" Value="#FFF1F5F9"/>
			<Setter Property="FontSize" Value="16"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Bd" Background="#FF334155" CornerRadius="6" Padding="14,8">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="#FF64748B"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<DataTemplate x:Key="CellTemplate">
			<Border x:Name="CellBox" Width="60" Height="60" Margin="2" CornerRadius="8"
					Background="#FF26303A" BorderBrush="#FF3A4856" BorderThickness="3">
				<b:Interaction.Triggers>
					<b:EventTrigger EventName="MouseLeftButtonDown">
						<b:InvokeCommandAction Command="{Binding OnMouseDown}"/>
					</b:EventTrigger>
					<b:EventTrigger EventName="MouseEnter">
						<b:InvokeCommandAction Command="{Binding OnMouseEnter}"/>
					</b:EventTrigger>
					<b:EventTrigger EventName="MouseLeftButtonUp">
						<b:InvokeCommandAction Command="{Binding OnMouseUp}"/>
					</b:EventTrigger>
					<b:EventTrigger EventName="TouchDown">
						<b:InvokeCommandAction Command="{Binding OnTouchDown}"/>
					</b:EventTrigger>
					<b:EventTrigger EventName="TouchEnter">
						<b:InvokeCommandAction Command="{Binding OnTouchEnter}"/>
					</b:EventTrigger>
					<b:EventTrigger EventName="TouchUp">
						<b:InvokeCommandAction Command="{Binding OnTouchUp}"/>
					</b:EventTrigger>
				</b:Interaction.Triggers>
				<TextBlock Text="{Binding Label}" Foreground="#FFFFFFFF" FontSize="22" FontWeight="Bold"
						   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
			</Border>
			<DataTemplate.Triggers>
				<DataTrigger Binding="{Binding State}" Value="red">
					<Setter TargetName="CellBox" Property="Background" Value="#FFE11D48"/>
				</DataTrigger>
				<DataTrigger Binding="{Binding State}" Value="blue">
					<Setter TargetName="CellBox" Property="Background" Value="#FF3B82F6"/>
				</DataTrigger>
				<DataTrigger Binding="{Binding State}" Value="green">
					<Setter TargetName="CellBox" Property="Background" Value="#FF14B8A6"/>
				</DataTrigger>
				<DataTrigger Binding="{Binding Mark}" Value="origin">
					<Setter TargetName="CellBox" Property="BorderBrush" Value="#FFFACC15"/>
					<Setter TargetName="CellBox" Property="Opacity" Value="0.55"/>
				</DataTrigger>
				<DataTrigger Binding="{Binding Mark}" Value="hover">
					<Setter TargetName="CellBox" Property="BorderBrush" Value="#FF4ADE80"/>
					<Setter TargetName="CellBox" Property="Background" Value="#FF1F4D36"/>
				</DataTrigger>
				<DataTrigger Binding="{Binding Mark}" Value="blocked">
					<Setter TargetName="CellBox" Property="BorderBrush" Value="#FFF87171"/>
				</DataTrigger>
				<DataTrigger Binding="{Binding Mark}" Value="selected">
					<Setter TargetName="CellBox" Property="BorderBrush" Value="#FFFFFFFF"/>
				</DataTrigger>
			</DataTemplate.Triggers>
		</DataTemplate>
	</Grid.Resources>

	<!-- Released outside the board: cell Up bubbles here last, so a drag still open means "outside". -->
	<b:Interaction.Triggers>
		<b:EventTrigger EventName="MouseLeftButtonUp">
			<b:InvokeCommandAction Command="{Binding OnRootUp}"/>
		</b:EventTrigger>
	</b:Interaction.Triggers>

	<Canvas>
		<TextBlock Canvas.Left="20" Canvas.Top="14" Text="Noesis DragLab  A: cell events"
				   Foreground="#FFF8FAFC" FontSize="22" FontWeight="Bold"/>
		<TextBlock Canvas.Left="20" Canvas.Top="50" Text="{Binding Status}"
				   Foreground="#FF94A3B8" FontSize="14"/>
		<TextBlock Canvas.Left="20" Canvas.Top="98" Text="press a piece, slide to another cell, release  (or tap piece, then tap empty cell)"
				   Foreground="#FFCBD5E1" FontSize="14"/>

		<ItemsControl Canvas.Left="20" Canvas.Top="130" Width="256" Height="256"
					  ItemsSource="{Binding Cells}" ItemTemplate="{StaticResource CellTemplate}">
			<ItemsControl.Template>
				<ControlTemplate TargetType="ItemsControl">
					<ItemsPresenter/>
				</ControlTemplate>
			</ItemsControl.Template>
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<UniformGrid Rows="4" Columns="4"/>
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>
		</ItemsControl>

		<StackPanel Canvas.Left="20" Canvas.Top="400" Orientation="Horizontal">
			<Button Style="{StaticResource LabButton}" Content="reset" Command="{Binding OnReset}"/>
			<Button Style="{StaticResource LabButton}" Margin="10,0,0,0"
					Content="{Binding UpdateLabel}" Command="{Binding OnToggleUpdate}"/>
		</StackPanel>

		<TextBlock Canvas.Left="300" Canvas.Top="130" Width="420" TextWrapping="Wrap" Text="{Binding Log}"
				   Foreground="#FFE2E8F0" FontSize="14"/>
	</Canvas>
</Grid>
